{
  "name": "tarot-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p convex --noEmit && tsc -p tests --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run lint && bun run test && prettier --check convex tests",
    "format": "prettier --write convex tests"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.51.0",
    "gsap": "^3.15.1",
    "jimp": "^1.6.1",
    "lucide-react": "^0.545.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1",
    "xendit-node": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
